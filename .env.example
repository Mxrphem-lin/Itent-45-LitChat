# Copy to .env and add the three proxy keys. Never commit .env.
BUILD_OPENAI_KEY=
BUILD_ANTHROPIC_KEY=
BUILD_GOOGLE_KEY=

# Optional model labels; defaults match https://proxy.litechat.ai/docs.
LITCHAT_OPENAI_MODEL=gpt-5.6-luna
LITCHAT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LITCHAT_GOOGLE_MODEL=gemini-3.8-flash
